generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
  UNKNOWN
  STALE
}

enum VerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  username      String   @unique
  passwordHash  String
  emailVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   ServerMembership[]
  invitations   ServerInvite[]
  auditLogs     AuditLog[]
}

model Server {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  description   String?
  status        ServerStatus @default(UNKNOWN)
  verification  VerificationState @default(UNVERIFIED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  externalIds   ServerExternalId[]
  observations  ServerObservation[]
  memberships   ServerMembership[]
  subscriptions ServerSubscription[]
  featureOverrides ServerFeatureOverride[]
  discordGuild  DiscordGuildConnection?
}

model ServerExternalId {
  id       String @id @default(uuid()) @db.Uuid
  serverId String @db.Uuid
  provider String
  externalId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([serverId])
}

model ServerObservation {
  id        String @id @default(uuid()) @db.Uuid
  serverId  String @db.Uuid
  source    String
  playerCount Int?
  maxPlayers Int?
  observedAt DateTime
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([serverId, observedAt])
}

model ServerMembership {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  serverId  String @db.Uuid
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

model ServerInvite {
  id         String @id @default(uuid()) @db.Uuid
  serverId   String @db.Uuid
  username   String
  invitedUserId String? @db.Uuid
  role       String
  status     String
  invitedBy  String @db.Uuid
  createdAt  DateTime @default(now())
  acceptedAt DateTime?
  user       User? @relation(fields: [invitedUserId], references: [id])

  @@index([serverId, status])
  @@index([username])
}

model AuditLog {
  id        String @id @default(uuid()) @db.Uuid
  actorId   String? @db.Uuid
  serverId  String? @db.Uuid
  action    String
  targetType String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([serverId, createdAt])
}

model FeatureCatalog {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  name        String
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  planFeatures PlanFeature[]
  overrides    ServerFeatureOverride[]
}

model SubscriptionPlan {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  features    PlanFeature[]
  subscriptions ServerSubscription[]
}

model PlanFeature {
  planId    String @db.Uuid
  featureId String @db.Uuid
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureCatalog @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
}

model ServerSubscription {
  id        String @id @default(uuid()) @db.Uuid
  serverId  String @db.Uuid
  planId    String @db.Uuid
  status    SubscriptionStatus
  startsAt  DateTime
  expiresAt DateTime?
  renewsAt  DateTime?
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serverId, status])
}

model ServerFeatureOverride {
  id        String @id @default(uuid()) @db.Uuid
  serverId  String @db.Uuid
  featureId String @db.Uuid
  granted   Boolean
  reason    String?
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  feature   FeatureCatalog @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([serverId, featureId])
}

model DiscordGuildConnection {
  id        String @id @default(uuid()) @db.Uuid
  serverId  String @db.Uuid @unique
  guildId   String @unique
  status    String
  lastSyncedAt DateTime?
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
